# Generated by scripts/sync_assets.py, which mirrors the web app's frontend out
# of src/plantuml_gui/ (a webview can only load files from inside the extension
# folder). Generated rather than committed so a stale mirror cannot be committed
# or reach anyone else's clone: `npm install` regenerates it, and
# `vscode:prepublish` regenerates it before every VSIX.
#
# Note that vsce reads .vscodeignore, not .gitignore, so these still ship in the
# VSIX -- see the comment there.
media/app/
media/menus/
media/vendor/
